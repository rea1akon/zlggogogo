# ============================================================
# Worker 本地密钥（复制为 .dev.vars 后生效，.dev.vars 已在 .gitignore 中）
#   cp .dev.vars.example .dev.vars
# 线上环境用: npx wrangler secret put <KEY>
# ============================================================

# 是否强制写操作鉴权：true=需要登录（默认），false=本地调试时放开
REQUIRE_AUTH=true

# 预留：接入第三方服务时放这里，例如对象存储、短信网关
# R2_ACCESS_KEY=xxx
# SMS_API_KEY=xxx
